QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_IN_MEMORY=false
QDRANT_COLLECTION_NAME=agent_memories

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

SERVER_HOST=0.0.0.0
SERVER_PORT=8001
LOG_LEVEL=INFO
API_PREFIX=/api/v1
SELF_PROJECT_ID=mnemoforge

# Public alpha baseline: keep optional modules disabled by default.
DISABLED_MODULES=auto_memory,code_search,layout_fixer,log_filter,openai_compat

# Security defaults. Set API_KEY before exposing the service outside localhost.
API_KEY=
INGEST_ALLOWED_ROOTS=
MAX_REQUEST_SIZE_MB=0
LLM_RATE_LIMIT_PER_MIN=0

MAX_SEARCH_RESULTS=20
CLEANUP_MIN_IMPORTANCE=0.2
CLEANUP_MAX_AGE_DAYS=30
INTEGRITY_AUDIT_INTERVAL_MINUTES=15
INTEGRITY_REMEDIATION_SYNC_MINUTES=1
INTEGRITY_AUTO_REMEDIATE=0
INTEGRITY_AUTO_DISCOVERY_LIMIT=50
INTEGRITY_AUTO_DISCOVERY_COOLDOWN_MINUTES=60
INTEGRITY_AUTO_REMEDIATE_COOLDOWN_MINUTES=60
DATA_HYGIENE_AUDIT_MINUTES=2
DATA_HYGIENE_MEMORY_LIMIT=100
DATA_HYGIENE_EVENT_LIMIT=100
DATA_HYGIENE_AUTO_TEST_CLEANUP=1
DATA_HYGIENE_AUTO_TEST_CLEANUP_LIMIT=200
PACKET_BACKGROUND_SYNC_MINUTES=1
AUTO_REBUILD_SELF_PROJECT_DOCS_MIN_AGE_MINUTES=60
PROJECT_TREE_DEDUPE_MINUTES=10
PROJECT_TREE_DEDUPE_GROUP_LIMIT=25

# Local and cloud LLM routing.
LLM_GATEWAY_ENABLE_LOCAL_FALLBACK=1
LOCAL_GENERATE_MODEL=qwen3:1.7b
ECONOMY_CLOUD_LLMS=
BALANCED_CLOUD_LLMS=
REASONING_CLOUD_LLMS=
DISABLED_CLOUD_LLMS=

# Generic OpenAI-compatible cloud provider. Leave blank unless configured.
CLOUD_LLM_PROVIDER=
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=
CLOUD_LLM_BASE_URL=

# Provider-specific keys used by optional model profiles.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=

# Optional JSON map/list of additional cloud model profiles.
# Keep this on one line in .env files.
# Example:
# CLOUD_LLM_MODEL_PROFILES={"deepseek-chat":{"provider":"deepseek","api_style":"openai-chat","api_key_env":"DEEPSEEK_API_KEY","base_url":"https://api.deepseek.com","model":"deepseek-chat","enabled":true}}
CLOUD_LLM_MODEL_PROFILES=

JOB_QUEUE_WORKERS=2
JOB_QUEUE_FAST_WORKERS=
JOB_QUEUE_SLOW_WORKERS=

# AI directory watcher / dialogue learning.
WATCHER_AUTO_START=false
WATCHER_AGENT_ID=ai-dirs
WATCHER_ENABLE_DIALOGUE_ANALYSIS=true
