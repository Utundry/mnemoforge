QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_IN_MEMORY=false
QDRANT_COLLECTION_NAME=agent_memories

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=1024

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api/v1

MAX_SEARCH_RESULTS=20
CLEANUP_MIN_IMPORTANCE=0.2
CLEANUP_MAX_AGE_DAYS=30

# Cloud LLM - configurable OpenAI-compatible provider
# Gemini OpenAI compatibility docs:
# https://ai.google.dev/gemini-api/docs/openai
CLOUD_LLM_PROVIDER=gemini
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=gemini-2.5-flash
CLOUD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Legacy GLM / Zhipu AI fallback (optional)
# GLM_API_KEY=
# GLM_MODEL=glm-4.5-air
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# AI directory watcher / dialogue learning
WATCHER_AUTO_START=true
WATCHER_AGENT_ID=ai-dirs
WATCHER_ENABLE_DIALOGUE_ANALYSIS=true
