QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_IN_MEMORY=false
QDRANT_COLLECTION_NAME=agent_memories

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

SERVER_HOST=0.0.0.0
SERVER_PORT=8001
LOG_LEVEL=INFO
API_PREFIX=/api/v1
SELF_PROJECT_ID=supermemory

# Public alpha baseline: keep experimental/legacy optional modules disabled by default
DISABLED_MODULES=auto_memory,code_search,layout_fixer,log_filter,openai_compat

# Security defaults
API_KEY=
INGEST_ALLOWED_ROOTS=
MAX_REQUEST_SIZE_MB=0
LLM_RATE_LIMIT_PER_MIN=0

MAX_SEARCH_RESULTS=20
CLEANUP_MIN_IMPORTANCE=0.2
CLEANUP_MAX_AGE_DAYS=30
INTEGRITY_AUDIT_INTERVAL_MINUTES=15
INTEGRITY_AUDIT_INTERVAL_HOURS=
INTEGRITY_REMEDIATION_SYNC_MINUTES=1
INTEGRITY_AUTO_REMEDIATE=0
INTEGRITY_AUTO_DISCOVERY_LIMIT=50
INTEGRITY_AUTO_DISCOVERY_COOLDOWN_MINUTES=60
INTEGRITY_AUTO_REMEDIATE_COOLDOWN_MINUTES=60
DATA_HYGIENE_AUDIT_MINUTES=2
DATA_HYGIENE_MEMORY_LIMIT=100
DATA_HYGIENE_EVENT_LIMIT=100
DATA_HYGIENE_AUTO_TEST_CLEANUP=1
DATA_HYGIENE_AUTO_TEST_CLEANUP_LIMIT=200
PACKET_BACKGROUND_SYNC_MINUTES=1
AUTO_REBUILD_SELF_PROJECT_DOCS_MIN_AGE_MINUTES=60
PROJECT_TREE_DEDUPE_MINUTES=10
PROJECT_TREE_DEDUPE_GROUP_LIMIT=25
LLM_GATEWAY_ENABLE_LOCAL_FALLBACK=1
LOCAL_GENERATE_MODEL=qwen3:1.7b
ECONOMY_CLOUD_LLMS=
BALANCED_CLOUD_LLMS=
REASONING_CLOUD_LLMS=
# Optional JSON map/list of additional cloud model profiles for true multi-provider failover.
# Example:
# CLOUD_LLM_MODEL_PROFILES={"gpt-4o-mini":{"provider":"openai","api_style":"openai-chat","api_key_env":"OPENAI_API_KEY","base_url":"https://api.openai.com/v1"}}
# Profiles accept enabled/active flags. Set enabled=false to keep a profile documented but inactive.
CLOUD_LLM_MODEL_PROFILES=
DISABLED_CLOUD_LLMS=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
JOB_QUEUE_WORKERS=2
JOB_QUEUE_FAST_WORKERS=
JOB_QUEUE_SLOW_WORKERS=

# Cloud LLM - configurable OpenAI-compatible provider
# Gemini OpenAI compatibility docs:
# https://ai.google.dev/gemini-api/docs/openai
CLOUD_LLM_PROVIDER=gemini
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=gemini-2.5-flash
CLOUD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Legacy GLM / Zhipu AI fallback (optional)
# GLM_API_KEY=
# GLM_MODEL=glm-4.5-air
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# AI directory watcher / dialogue learning
WATCHER_AUTO_START=false
WATCHER_AGENT_ID=ai-dirs
WATCHER_ENABLE_DIALOGUE_ANALYSIS=tr№ue

#----------------------
# Local fallback
LLM_GATEWAY_ENABLE_LOCAL_FALLBACK=1
LOCAL_GENERATE_MODEL=qwen3:1.7b

# Direct GLM
GLM_API_KEY=your_glm_key
GLM_MODEL=glm-4.5-air
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Aggregator / provider keys
AGG1_API_KEY=your_aggregator1_key
AGG2_API_KEY=your_aggregator2_key
OPENAI_API_KEY=your_openai_key

# Extra cloud profiles
CLOUD_LLM_MODEL_PROFILES={
  "deepseek-chat":{"provider":"deepseek","api_style":"openai-chat","api_key_env":"DEEPSEEK_API_KEY","base_url":"https://api.deepseek.com","model":"deepseek-chat","enabled":true},
  "agg1-gpt-4o-mini":{"provider":"aggregator1","api_style":"openai-chat","api_key_env":"AGG1_API_KEY","base_url":"https://agg1.example/v1","model":"gpt-4o-mini"},
  "agg2-gemini-flash":{"provider":"aggregator2","api_style":"openai-chat","api_key_env":"AGG2_API_KEY","base_url":"https://agg2.example/v1","model":"gemini-2.5-flash"},
  "openai-gpt-4o-mini":{"provider":"openai","api_style":"openai-chat","api_key_env":"OPENAI_API_KEY","base_url":"https://api.openai.com/v1","model":"gpt-4o-mini"},
  "gemini-3-flash-preview":{"provider":"gemini","api_style":"gemini-native","api_key_env":"GEMINI_API_KEY","base_url":"https://generativelanguage.googleapis.com/v1beta","model":"gemini-3-flash-preview","enabled":false}
}

# Cheap-first order
ECONOMY_CLOUD_LLMS=deepseek-chat,agg1-gpt-4o-mini,agg2-gemini-flash,glm-4.5-air,openai-gpt-4o-mini

# Default balanced order
BALANCED_CLOUD_LLMS=deepseek-chat,glm-4.5-air,agg2-gemini-flash,agg1-gpt-4o-mini,openai-gpt-4o-mini

# Higher-quality / reasoning order
REASONING_CLOUD_LLMS=deepseek-chat,glm-4.5-air,openai-gpt-4o-mini,agg2-gemini-flash,agg1-gpt-4o-mini
