# Dot-prefixed local state: ignore by default, then explicitly allow repo-owned dotfiles.
.*
!.dockerignore
!.env.public.example
!.gitignore

# Environment variables
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv*/
venv/
ENV/
env/
.conda/

# Testing
.pytest*/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

