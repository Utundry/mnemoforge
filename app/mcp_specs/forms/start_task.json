{
  "id": "start_task",
  "title": "Start task session",
  "purpose": "Claim a task lease as a protective workspace lock, start a work session, and record an initial lightweight checkpoint through one public mailbox form.",
  "states": ["planning", "implementation"],
  "mode": "transition",
  "required_fields": ["project", "task_id"],
  "optional_fields": ["owner_agent", "session_id", "agent_fingerprint", "runtime_profile_id", "work_token", "lease_ttl_seconds", "auto_heartbeat", "heartbeat_seconds", "role", "summary", "approved_framing", "framing_version", "approval_intent", "autonomous_mode"],
  "input_schema": {
    "type": "object",
    "properties": {
      "project": {"type": "string", "default": "mnemoforge"},
      "task_id": {"type": "string"},
      "owner_agent": {"type": "string", "default": "codex"},
      "session_id": {"type": "string"},
      "agent_fingerprint": {"type": "string"},
      "runtime_profile_id": {"type": "string", "default": "unknown_cli"},
      "work_token": {"type": "string"},
      "lease_ttl_seconds": {"type": "integer", "minimum": 5, "maximum": 86400, "default": 900},
      "auto_heartbeat": {"type": "boolean", "default": true},
      "heartbeat_seconds": {"type": "number", "minimum": 1},
      "role": {"type": "string", "default": "worker"},
      "summary": {"type": "string", "default": "Task claimed; work session started."},
      "approved_framing": {"type": "string", "description": "Latest user-visible framing that received explicit approval."},
      "framing_version": {"type": "string", "description": "Stable caller-provided version of the approved framing; generated from approved_framing when omitted."},
      "approval_intent": {"type": "string", "default": "user_approved_start"},
      "autonomous_mode": {
        "type": "object",
        "description": "Explicit operator-approved session grant. approved_task_ids is exhaustive; task relations never expand it.",
        "properties": {
          "mode": {"type": "string", "enum": ["collaborative_control", "explicit_autonomous_mode"], "default": "collaborative_control"},
          "approval_intent": {"type": "string"},
          "approval_ref": {"type": "string"},
          "approved_task_ids": {"type": "array", "items": {"type": "string"}},
          "task_framing_versions": {"type": "object", "additionalProperties": {"type": "string"}},
          "allowed_actions": {"type": "array", "items": {"type": "string"}},
          "expires_at": {"type": "string"},
          "permissions": {
            "type": "object",
            "properties": {
              "commit": {"type": "boolean", "default": false},
              "live_mutation": {"type": "boolean", "default": false}
            }
          }
        }
      }
    },
    "required": ["project", "task_id"]
  },
  "assistance": {
    "clerk_available": false,
    "can_use_stenography": false,
    "default_mode": "none"
  },
  "feature_toggles": [],
  "replacement_form_ids": ["claim_task", "get_task_context"],
  "postconditions": {
    "expected_metadata": {
      "result_kind": "task_started",
      "mutation": true
    },
    "forbidden_metadata": {},
    "required_receipt_fields": ["status", "lease", "work_handle", "work_session"]
  },
  "public_hint": "Use this before real implementation work, after the latest user-visible task framing has been reviewed and user_approved_start is satisfied, unless explicit_autonomous_mode is active. The claim is not permission friction: it protects your working context from concurrent agents and gives the server continuity for checkpoints, recovery, and finish_task. Provide approved_framing when possible. Approval does not survive scope drift. Keep the returned work_handle and reuse it for record_progress, finish_task, and recovery; legacy work_token remains internal/diagnostic."
}
