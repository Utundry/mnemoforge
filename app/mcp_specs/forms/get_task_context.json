{
  "id": "get_task_context",
  "title": "Get task context",
  "purpose": "Fetch compact task context, rules, latest checkpoint, and next safe action.",
  "states": ["planning", "implementation", "verification", "checkpointing", "handoff"],
  "mode": "read",
  "required_fields": ["project"],
  "optional_fields": ["task_id", "detail"],
  "input_schema": {
    "type": "object",
    "properties": {
      "project": {"type": "string", "default": "mnemoforge"},
      "task_id": {"type": "string"},
      "detail": {"type": "string", "enum": ["compact", "full"], "default": "compact"}
    },
    "required": ["project"]
  },
  "assistance": {
    "clerk_available": false,
    "can_use_stenography": false,
    "default_mode": "none"
  },
  "feature_toggles": [],
  "replacement_form_ids": [],
  "postconditions": {
    "expected_metadata": {
      "result_kind": "state_data",
      "mutation": false
    },
    "forbidden_metadata": {
      "mutation": [true]
    },
    "required_receipt_fields": ["status", "data_ref"]
  },
  "public_hint": "Use this before editing when task context or rules are unclear."
}
