{
  "id": "claim_task",
  "title": "Claim or reclaim task",
  "purpose": "Claim a task lease as a protective workspace lock, or safely reclaim the same task after session loss using continuity evidence.",
  "states": ["planning", "implementation", "handoff"],
  "mode": "transition",
  "required_fields": ["project", "task_id"],
  "optional_fields": ["owner_agent", "session_id", "agent_fingerprint", "runtime_profile_id", "work_token", "lease_ttl_seconds"],
  "input_schema": {
    "type": "object",
    "properties": {
      "project": {"type": "string", "default": "mnemoforge"},
      "task_id": {"type": "string"},
      "owner_agent": {"type": "string", "default": "codex"},
      "session_id": {"type": "string"},
      "agent_fingerprint": {"type": "string"},
      "runtime_profile_id": {"type": "string", "default": "unknown_cli"},
      "work_token": {"type": "string"},
      "lease_ttl_seconds": {"type": "integer", "minimum": 5, "maximum": 86400, "default": 900}
    },
    "required": ["project", "task_id"]
  },
  "assistance": {
    "clerk_available": false,
    "can_use_stenography": false,
    "default_mode": "none"
  },
  "feature_toggles": [],
  "replacement_form_ids": ["get_task_context"],
  "postconditions": {
    "expected_metadata": {
      "result_kind": "task_claim",
      "mutation": true
    },
    "forbidden_metadata": {},
    "required_receipt_fields": ["status", "lease"]
  },
  "public_hint": "Use this before editing or mutating a task when start_task is not the right public form. A claim protects your work from concurrent agents; it does not grant editing authority by itself. Keep the returned work_handle for checkpoint, finish, and same-fingerprint recovery; legacy work_token is only for compatibility/diagnostic recovery."
}
